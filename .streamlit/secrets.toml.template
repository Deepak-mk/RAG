# Streamlit Secrets Template
# Copy this to .streamlit/secrets.toml and fill in your values.
# DO NOT commit secrets.toml — it is in .gitignore.

# ─── Required secrets ────────────────────────────────────────────────────────

# Groq API key (https://console.groq.com)
GROQ_API_KEY = "your_groq_api_key_here"

# Qdrant Cloud URL and API key (https://cloud.qdrant.io)
QDRANT_URL = "https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io"
QDRANT_API_KEY = "your_qdrant_api_key_here"

# ─── Login credentials ───────────────────────────────────────────────────────
APP_USERNAME = "admin"
APP_PASSWORD = "admin123"
